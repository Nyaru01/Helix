<ui:FluentWindow x:Class="LocalBlast.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Helix Blast" Width="1280" Height="820" MinWidth="1050" MinHeight="700"
                 WindowStartupLocation="CenterScreen" Icon="/app.ico"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
    <ui:FluentWindow.Resources>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#A9BECC"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="PanelTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F3FBFF"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid Background="#091522">
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="76"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="76"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Helix Blast"/>

        <Border Grid.Row="1" Background="#101E2D" BorderBrush="#294155" BorderThickness="0,0,0,1">
            <Grid Margin="22,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="36" Height="36" CornerRadius="10" Background="#1E8EB6" Margin="0,0,10,0">
                        <TextBlock Text="⌁" Foreground="White" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="Helix Blast" FontSize="18" FontWeight="SemiBold" Foreground="#F3FBFF"/>
                        <TextBlock x:Name="VersionText" Text="Version" FontSize="11" Foreground="#8DA7B8"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button Content="History" Click="History_Click" Appearance="Secondary" Margin="0,0,7,0"/>
                    <ui:Button Content="Prepare indexes" Click="PrepareIndexes_Click" Appearance="Secondary" Margin="0,0,7,0"/>
                    <ui:Button Content="Check BLAST" Click="CheckEnvironment_Click" Appearance="Secondary" Margin="0,0,7,0"/>
                    <ui:Button Content="Diagnostics" Click="Diagnostics_Click" Appearance="Secondary" Margin="0,0,7,0"/>
                    <ui:Button Content="Updates" Click="CheckUpdates_Click" Appearance="Secondary"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="20,18,20,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.5*" MinWidth="580"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="1*" MinWidth="365"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#152333" BorderBrush="#2A4054" BorderThickness="1" CornerRadius="12">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Border Padding="16,12" BorderBrush="#2A4054" BorderThickness="0,0,0,1">
                            <StackPanel>
                                <TextBlock Text="Query sequence" Style="{StaticResource PanelTitleStyle}"/>
                                <TextBlock Text="Paste a nucleotide/protein sequence or load a FASTA file" Foreground="#8DA7B8" FontSize="11" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                        <Grid Grid.Row="1" Margin="16,14,16,14">
                            <Grid.RowDefinitions><RowDefinition Height="180"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBox x:Name="QueryTextBox" AcceptsReturn="True" AcceptsTab="True"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                     FontFamily="Cascadia Mono, Consolas" FontSize="12" TextWrapping="NoWrap"
                                     SpellCheck.IsEnabled="False" AllowDrop="True" Drop="QueryTextBox_Drop" DragOver="FileDrop_DragOver"/>
                            <Grid Grid.Row="1" Margin="0,10,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <ui:Button Content="Load query FASTA" Click="LoadQuery_Click" Appearance="Secondary"/>
                                <TextBlock x:Name="QueryInfoText" Grid.Column="1" Margin="12,6,0,0" Foreground="#8DA7B8" TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Background="#152333" BorderBrush="#2A4054" BorderThickness="1" CornerRadius="12" ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="16,12,16,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Results" Style="{StaticResource PanelTitleStyle}"/>
                                <TextBlock x:Name="ResultsSummaryText" Text="No analysis yet" Foreground="#8DA7B8" FontSize="11" Margin="0,3,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:Button x:Name="ExportCsvButton" Content="CSV" Click="ExportCsv_Click" Appearance="Secondary" IsEnabled="False" Margin="0,0,6,0"/>
                                <ui:Button x:Name="ExportHtmlButton" Content="HTML report" Click="ExportHtml_Click" Appearance="Secondary" IsEnabled="False" Margin="0,0,6,0"/>
                                <ui:Button x:Name="ExportPdfButton" Content="PDF" Click="ExportPdf_Click" Appearance="Secondary" IsEnabled="False"/>
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Row="1" Margin="16,0,16,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="165"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="ResultsSearchTextBox" Height="34" VerticalContentAlignment="Center" ToolTip="Search sample, contig or file" TextChanged="ResultsFilterChanged"/>
                            <ComboBox x:Name="ResultsStatusComboBox" Grid.Column="2" Height="34" SelectionChanged="ResultsFilterChanged">
                                <ComboBoxItem Content="All statuses" IsSelected="True"/>
                                <ComboBoxItem Content="Present"/>
                                <ComboBoxItem Content="Below thresholds"/>
                                <ComboBoxItem Content="No hit"/>
                                <ComboBoxItem Content="Error"/>
                            </ComboBox>
                        </Grid>
                        <DataGrid x:Name="ResultsGrid" Grid.Row="2" Margin="0" AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="True"
                                  SelectionMode="Single" SelectionUnit="FullRow" RowHeight="34" ColumnHeaderHeight="32"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" MouseDoubleClick="ResultsGrid_MouseDoubleClick"
                                  AlternatingRowBackground="#102333">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Sample" Binding="{Binding GenomeName}" Width="2*" MinWidth="150"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="1.3*" MinWidth="118"/>
                                <DataGridTextColumn Header="Identity" Binding="{Binding IdentityDisplay}" Width="86"/>
                                <DataGridTextColumn Header="Coverage" Binding="{Binding CoverageDisplay}" Width="86"/>
                                <DataGridTextColumn Header="Subject / contig" Binding="{Binding SubjectId}" Width="2*" MinWidth="145"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Border Background="#152333" BorderBrush="#2A4054" BorderThickness="1" CornerRadius="12" Margin="0,0,0,16">
                        <StackPanel>
                            <Border Padding="16,12" BorderBrush="#2A4054" BorderThickness="0,0,0,1">
                                <StackPanel><TextBlock Text="Reference collection" Style="{StaticResource PanelTitleStyle}"/><TextBlock Text="One sample per compatible FASTA file" Foreground="#8DA7B8" FontSize="11" Margin="0,3,0,0"/></StackPanel>
                            </Border>
                            <StackPanel Margin="16,14,16,16">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBox x:Name="FolderTextBox" Height="36" VerticalContentAlignment="Center" LostFocus="FolderTextBox_LostFocus" AllowDrop="True" Drop="FolderTextBox_Drop" DragOver="FileDrop_DragOver"/>
                                    <ui:Button Grid.Column="2" Content="Browse…" Click="BrowseFolder_Click" Appearance="Secondary"/>
                                </Grid>
                                <Border Background="#123239" CornerRadius="8" Padding="10" Margin="0,10,0,0">
                                    <TextBlock x:Name="FolderInfoText" Text="Choose a FASTA folder" Foreground="#8DD2BD" FontSize="11" TextWrapping="Wrap"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Background="#152333" BorderBrush="#2A4054" BorderThickness="1" CornerRadius="12">
                        <StackPanel>
                            <Border Padding="16,12" BorderBrush="#2A4054" BorderThickness="0,0,0,1">
                                <StackPanel><TextBlock Text="Search settings" Style="{StaticResource PanelTitleStyle}"/><TextBlock Text="Configure thresholds before running" Foreground="#8DA7B8" FontSize="11" Margin="0,3,0,0"/></StackPanel>
                            </Border>
                            <Grid Margin="16">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <StackPanel>
                                    <TextBlock Text="BLAST program" Style="{StaticResource FieldLabelStyle}"/>
                                    <ComboBox x:Name="ProgramComboBox" Height="36" SelectionChanged="ProgramComboBox_SelectionChanged">
                                        <ComboBoxItem Content="blastn" IsSelected="True"/><ComboBoxItem Content="tblastn"/><ComboBoxItem Content="blastp"/>
                                    </ComboBox>
                                </StackPanel>
                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="Min. identity (%)" Style="{StaticResource FieldLabelStyle}"/><TextBox x:Name="IdentityTextBox" Text="80" Height="36" VerticalContentAlignment="Center"/></StackPanel>
                                    <StackPanel Grid.Column="2"><TextBlock Text="Min. coverage (%)" Style="{StaticResource FieldLabelStyle}"/><TextBox x:Name="CoverageTextBox" Text="80" Height="36" VerticalContentAlignment="Center"/></StackPanel>
                                </Grid>
                                <StackPanel Grid.Row="4">
                                    <TextBlock Text="E-value threshold" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox x:Name="EvalueTextBox" Text="1e-10" Height="36" VerticalContentAlignment="Center"/>
                                    <Border Background="#102D39" BorderBrush="#37B8BA" BorderThickness="3,0,0,0" Padding="10,8" Margin="0,12,0,0">
                                        <TextBlock x:Name="ProgramHelpText" Text="blastn: nucleotide query → nucleotide FASTA files" Foreground="#A2CCD1" FontSize="11" TextWrapping="Wrap"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="3" Background="#101E2D" BorderBrush="#294155" BorderThickness="0,1,0,0">
            <Grid Margin="20,12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="#41D0A4" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock x:Name="EnvironmentText" Text="Local BLAST" Foreground="#75D8B9" FontSize="12" Margin="0,0,13,0"/>
                        <TextBlock x:Name="StatusText" Text="Ready." Foreground="#A7BAC8" FontSize="12" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <ProgressBar x:Name="SearchProgressBar" Height="4" Minimum="0" Maximum="100" Value="0" Margin="0,8,28,0"/>
                </StackPanel>
                <ui:Button x:Name="CancelButton" Grid.Column="1" Content="Cancel" IsEnabled="False" Click="Cancel_Click" Appearance="Secondary" MinWidth="90"/>
                <ui:Button x:Name="RunButton" Grid.Column="3" Content="Run analysis" Click="RunBlast_Click" Appearance="Primary" MinWidth="172" Height="42"/>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
