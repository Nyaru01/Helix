<Window x:Class="LocalBlast.Windows.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="520" Height="420" WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        AllowsTransparency="True" Background="Transparent" Topmost="True">
    <Window.Resources>
        <Storyboard x:Key="LoadingAnimation" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="Orbit"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                             From="0" To="360" Duration="0:0:5" />
            <DoubleAnimation Storyboard.TargetName="HelixGlow" Storyboard.TargetProperty="Opacity"
                             From="0.25" To="0.8" Duration="0:0:1.25" AutoReverse="True" />
            <DoubleAnimation Storyboard.TargetName="Scanner"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                             From="-72" To="72" Duration="0:0:1.8" AutoReverse="True" />
            <DoubleAnimation Storyboard.TargetName="LoadingDot1" Storyboard.TargetProperty="Opacity"
                             From="0.25" To="1" Duration="0:0:0.7" AutoReverse="True" />
            <DoubleAnimation Storyboard.TargetName="LoadingDot2" Storyboard.TargetProperty="Opacity"
                             From="0.25" To="1" BeginTime="0:0:0.2" Duration="0:0:0.7" AutoReverse="True" />
            <DoubleAnimation Storyboard.TargetName="LoadingDot3" Storyboard.TargetProperty="Opacity"
                             From="0.25" To="1" BeginTime="0:0:0.4" Duration="0:0:0.7" AutoReverse="True" />
        </Storyboard>
    </Window.Resources>

    <Border CornerRadius="24" BorderBrush="#315371" BorderThickness="1" Padding="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="34" ShadowDepth="8" Opacity="0.5" Color="#020711" />
        </Border.Effect>
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0D1930" Offset="0" />
                <GradientStop Color="#07101F" Offset="0.56" />
                <GradientStop Color="#08232C" Offset="1" />
            </LinearGradientBrush>
        </Border.Background>

        <Grid Margin="42,30,42,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="210" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Width="210" Height="210" HorizontalAlignment="Center">
                <Ellipse Width="178" Height="178" Stroke="#173B54" StrokeThickness="1" />
                <Ellipse Width="154" Height="154" Stroke="#1A7080" StrokeThickness="1" Opacity="0.55" />
                <Grid x:Name="Orbit" Width="190" Height="190" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform><RotateTransform /></Grid.RenderTransform>
                    <Ellipse Stroke="#35DDD5" StrokeThickness="1.5" StrokeDashArray="1 8" Opacity="0.5" />
                    <Ellipse Width="9" Height="9" Fill="#77FFF4" VerticalAlignment="Top" Margin="0,-4,0,0">
                        <Ellipse.Effect><DropShadowEffect Color="#31E5DC" BlurRadius="14" ShadowDepth="0" /></Ellipse.Effect>
                    </Ellipse>
                </Grid>

                <Grid Width="138" Height="156" ClipToBounds="True">
                    <Path x:Name="HelixGlow" Stroke="#28E9DD" StrokeThickness="18" Opacity="0.35"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M35,8 C120,40 20,112 103,148">
                        <Path.Effect><BlurEffect Radius="13" /></Path.Effect>
                    </Path>
                    <Path Stroke="#28DDD3" StrokeThickness="9" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M35,8 C120,40 20,112 103,148" />
                    <Path Stroke="#267BD9" StrokeThickness="9" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M103,8 C20,40 120,112 35,148" />
                    <StackPanel VerticalAlignment="Center" Margin="31,0" IsHitTestVisible="False">
                        <Rectangle Height="4" RadiusX="2" Fill="#B8FFF8" Margin="0,0,0,25" />
                        <Rectangle Height="4" RadiusX="2" Fill="#B8FFF8" Margin="-7,0,-7,25" />
                        <Rectangle Height="4" RadiusX="2" Fill="#B8FFF8" />
                    </StackPanel>
                    <Rectangle x:Name="Scanner" Height="2" Margin="18,0" VerticalAlignment="Center" Opacity="0.85">
                        <Rectangle.RenderTransform><TranslateTransform /></Rectangle.RenderTransform>
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="Transparent" />
                                <GradientStop Color="#E5FFFC" Offset="0.5" />
                                <GradientStop Color="Transparent" Offset="1" />
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                        <Rectangle.Effect><DropShadowEffect Color="#44FFF3" BlurRadius="10" ShadowDepth="0" /></Rectangle.Effect>
                    </Rectangle>
                </Grid>
            </Grid>

            <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,-2,0,0">
                <TextBlock HorizontalAlignment="Center" FontSize="30" FontWeight="SemiBold">
                    <Run Text="HELIX" Foreground="#F2F8FF"/><Run Text=" BLAST" Foreground="#38DED4"/>
                </TextBlock>
                <TextBlock Text="L O C A L   S E Q U E N C E   A N A L Y S I S" Foreground="#789CB2" FontSize="9"
                           FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,7,0,0" />
            </StackPanel>

            <StackPanel Grid.Row="2" VerticalAlignment="Bottom">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
                    <TextBlock Text="Preparing local analysis engine" Foreground="#A7BDCC" FontSize="12" />
                    <TextBlock x:Name="LoadingDot1" Text="·" Foreground="#45E4DA" FontSize="16" Margin="7,-3,0,0" />
                    <TextBlock x:Name="LoadingDot2" Text="·" Foreground="#45E4DA" FontSize="16" Margin="2,-3,0,0" />
                    <TextBlock x:Name="LoadingDot3" Text="·" Foreground="#45E4DA" FontSize="16" Margin="2,-3,0,0" />
                </StackPanel>
                <ProgressBar Height="4" IsIndeterminate="True" Foreground="#31DDD4" Background="#183044" />
                <TextBlock Text="Your sequences stay on this computer" Foreground="#57778D" FontSize="10"
                           HorizontalAlignment="Center" Margin="0,10,0,0" />
            </StackPanel>
        </Grid>
    </Border>

    <Window.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard Storyboard="{StaticResource LoadingAnimation}" />
        </EventTrigger>
    </Window.Triggers>
</Window>
