<Window x:Class="LocalBlast.Windows.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="460" Height="460" WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="#08101F" Topmost="True">
    <Border Background="#08101F" CornerRadius="20" BorderBrush="#27435B" BorderThickness="1" ClipToBounds="True">
        <Grid Margin="42">
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="210" Height="210">
                <Ellipse Stroke="#17D9D1" StrokeThickness="2" Opacity=".45" Margin="15"/>
                <Path Stroke="#30E3D8" StrokeThickness="10" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M55,20 C170,55 40,145 155,190"/>
                <Path Stroke="#2377D6" StrokeThickness="10" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M155,20 C40,55 170,145 55,190"/>
                <Line X1="70" Y1="54" X2="140" Y2="54" Stroke="#A3FFF4" StrokeThickness="4"/>
                <Line X1="61" Y1="105" X2="149" Y2="105" Stroke="#A3FFF4" StrokeThickness="4"/>
                <Line X1="70" Y1="156" X2="140" Y2="156" Stroke="#A3FFF4" StrokeThickness="4"/>
            </Grid>
            <StackPanel Grid.Row="1" HorizontalAlignment="Center">
                <TextBlock Text="HELIX BLAST" Foreground="#F3FBFF" FontSize="27" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Text="LOCAL SEQUENCE ANALYSIS" Foreground="#78A1B7" FontSize="10" HorizontalAlignment="Center" Margin="0,7,0,0" />
            </StackPanel>
            <StackPanel Grid.Row="2" Margin="0,30,0,0">
                <ProgressBar Height="5" IsIndeterminate="True" Foreground="#31DDD4" Background="#1C3147" />
                <TextBlock Text="Preparing local analysis engine" Foreground="#92AFC1" FontSize="12" HorizontalAlignment="Center" Margin="0,10,0,0" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
